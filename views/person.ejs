<%- include('partials/head') %>
<div class="layout">
  <article>
    <div class="person-head big">
      <span class="avatar large"><%= h.initials(person.name) %></span>
      <div>
        <h1><%= person.name %></h1>
        <div class="muted"><%= [person.headline, person.level].filter(Boolean).join(' · ') || 'Member' %></div>
      </div>
    </div>
    <% if (person.bio) { %><h2>About</h2><p class="pre"><%= person.bio %></p><% } %>
    <% if (person.skills) { %><h2>Skills</h2><div class="tags"><% h.tagList(person.skills).forEach(function (t) { %><a class="tag" href="/people?skill=<%= encodeURIComponent(t) %>"><%= t %></a><% }) %></div><% } %>
    <% if (person.interests) { %><h2>Interested in</h2><div class="tags"><% h.tagList(person.interests).forEach(function (t) { %><span class="tag"><%= t %></span><% }) %></div><% } %>
    <h2>Projects</h2>
    <% if (!projects.length) { %><p class="muted">Not on any projects yet.</p><% } %>
    <div class="grid two-col"><% projects.forEach(function (p) { %><%- include('partials/project-card', { p: p }) %><% }) %></div>
  </article>
  <aside>
    <div class="card">
      <% if (person.id === user.id) { %>
        <a class="btn block" href="/profile/edit">Edit your profile</a>
      <% } else { %>
        <a class="btn block" href="/messages/<%= person.id %>">Message <%= person.name.split(' ')[0] %></a>
      <% } %>
      <dl>
        <% if (person.location) { %><dt>Based in</dt><dd><%= person.location %><% if (person.id !== user.id && h.sameArea(user.location, person.location)) { %> <span class="pill green">Near you</span><% } %></dd><% } %>
        <% if (person.availability) { %><dt>Free to meet</dt><dd><%= person.availability %></dd><% } %>
        <% if (person.link) { %><dt>Link</dt><dd><a href="<%= person.link %>" rel="noopener nofollow" target="_blank"><%= person.link.replace(/^https?:\/\//, '').slice(0, 40) %></a></dd><% } %>
        <dt>Joined</dt><dd><%= h.timeAgo(person.created_at) %></dd>
      </dl>
    </div>
  </aside>
</div>
<%- include('partials/foot') %>
