<% if (pages > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a class="btn ghost small" href="<%= base %><%= h.qs(Object.assign({}, f, { page: page - 1 })) %>">← Newer</a><% } %>
    <span class="muted">Page <%= page %> of <%= pages %></span>
    <% if (page < pages) { %><a class="btn ghost small" href="<%= base %><%= h.qs(Object.assign({}, f, { page: page + 1 })) %>">Older →</a><% } %>
  </div>
<% } %>
