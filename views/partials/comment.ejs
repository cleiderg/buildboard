<div class="comment">
  <span class="avatar small"><%= h.initials(c.name) %></span>
  <div class="grow">
    <div class="small-text">
      <% if (user) { %><a href="/people/<%= c.user_id %>"><strong><%= c.name %></strong></a><% } else { %><strong><%= c.name %></strong><% } %>
      <% if (c.user_id === project.owner_id) { %><span class="pill">Owner</span><% } %>
      <span class="muted"><%= h.timeAgo(c.created_at) %></span>
    </div>
    <p class="pre"><%= c.body %></p>
  </div>
  <% if (user && (c.user_id === user.id || owner)) { %>
    <form method="post" action="/comments/<%= c.id %>/delete" data-confirm="Delete this message?"><%- csrfField %><button class="link danger small-text">Delete</button></form>
  <% } %>
</div>
