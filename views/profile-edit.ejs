<%- include('partials/head') %>
<div class="form-box wide">
  <h1>Edit profile</h1>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/profile" class="stack">
    <%- csrfField %>
    <label>Name <input name="name" value="<%= form.name || '' %>" maxlength="60" required></label>
    <label>What you do <input placeholder="Backend developer, CS student, hobbyist…" name="headline" value="<%= form.headline || '' %>" maxlength="80"></label>
    <div class="two">
      <label>Experience level <select name="level"><option value="">—</option><% C.LEVELS.forEach(function (y) { %><option <%= form.level === y ? 'selected' : '' %>><%= y %></option><% }) %></select></label>
      <label>City or area <input name="location" value="<%= form.location || '' %>" maxlength="60" placeholder="Austin, TX"><span class="hint">Used to show you people and projects nearby. Type it the way locals do, e.g. "Austin, TX".</span></label>
    </div>
    <label>Skills <input name="skills" value="<%= h.tagList(form.skills).join(', ') %>" placeholder="python, react, rust, pcb design"><span class="hint">Separate with commas. Project owners search by these.</span></label>
    <label>Interests <input name="interests" value="<%= h.tagList(form.interests).join(', ') %>" placeholder="robotics, open source, game dev"></label>
    <label>About you <textarea name="bio" rows="4" maxlength="1000" placeholder="What do you like to build? What are you hoping to work on?"><%= form.bio || '' %></textarea></label>
    <label>When you're usually free to meet <input name="availability" value="<%= form.availability || '' %>" maxlength="120" placeholder="Weekday evenings, Saturday afternoons"></label>
    <label>Link <span class="hint">GitHub, portfolio, LinkedIn…</span><input name="link" value="<%= form.link || '' %>" maxlength="200" placeholder="https://github.com/you"></label>
    <div class="row"><button class="btn">Save profile</button><a href="/people/<%= user.id %>">Cancel</a></div>
  </form>

  <h2>Change password</h2>
  <form method="post" action="/profile/password" class="stack">
    <%- csrfField %>
    <div class="two">
      <label>Current password <input type="password" name="current" required></label>
      <label>New password <input type="password" name="password" minlength="8" required></label>
    </div>
    <div><button class="btn ghost">Change password</button></div>
  </form>
</div>
<%- include('partials/foot') %>
