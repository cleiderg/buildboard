<%- include('partials/head') %>
<div class="form-box">
  <h1>Log in</h1>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/login" class="stack">
    <%- csrfField %>
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email <input type="email" name="email" value="<%= email %>" placeholder="you@example.com" required autofocus></label>
    <label>Password <input type="password" name="password" required></label>
    <button class="btn">Log in</button>
  </form>
  <p class="muted">New here? <a href="/signup">Create an account</a></p>
</div>
<%- include('partials/foot') %>
