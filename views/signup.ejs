<%- include('partials/head') %>
<div class="form-box">
  <h1>Join <%= C.SITE_NAME %></h1>
  <p class="muted">Open to anyone who wants to work on technical projects.</p>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/signup" class="stack">
    <%- csrfField %>
    <label>Name <input name="name" value="<%= form.name || '' %>" maxlength="60" required autofocus></label>
    <label>Email <input type="email" name="email" value="<%= form.email || '' %>" placeholder="you@example.com" required></label>
    <label>Password <input type="password" name="password" minlength="8" required><span class="hint">At least 8 characters.</span></label>
    <label>What you do <span class="hint">optional</span><input name="headline" value="<%= form.headline || '' %>" maxlength="80" placeholder="Backend developer, CS student, hobbyist…"></label>
    <div class="two">
      <label>Experience level
        <select name="level"><option value="">—</option><% C.LEVELS.forEach(function (y) { %><option <%= form.level === y ? 'selected' : '' %>><%= y %></option><% }) %></select>
      </label>
      <label>City or area <span class="hint">optional</span>
        <input name="location" value="<%= form.location || '' %>" maxlength="60" placeholder="Austin, TX">
      </label>
    </div>
    <button class="btn">Create account</button>
  </form>
  <p class="muted">Already have an account? <a href="/login">Log in</a></p>
</div>
<%- include('partials/foot') %>
