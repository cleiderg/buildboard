<%- include('partials/head') %>
<h1>People</h1>
<p class="muted">Find people to build with. People based in your area are listed first.</p>
<form method="get" action="/people" class="filters card">
  <input type="search" name="q" value="<%= f.q %>" placeholder="Search name, role, interests…" class="grow">
  <input name="skill" value="<%= f.skill %>" placeholder="Skill, e.g. figma" aria-label="Skill">
  <select name="level" aria-label="Experience level"><option value="">Any level</option><% C.LEVELS.forEach(function (c) { %><option <%= f.level === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
  <input name="location" value="<%= f.location %>" placeholder="City or area" aria-label="City or area">
  <% if (user.location) { %><label class="check"><input type="checkbox" name="near" value="1" <%= f.near ? 'checked' : '' %>> Near me</label><% } %>
  <button class="btn">Search</button>
  <a href="/people" class="small-text">Reset</a>
</form>
<% if (!user.location) { %><p class="flash ok">Add where you're based on <a href="/profile/edit">your profile</a> to see who is near you.</p><% } %>
<p class="muted"><%= total %> <%= total === 1 ? 'person' : 'people' %> found</p>
<div class="grid"><% people.forEach(function (person) { %><%- include('partials/person-card', { person: person }) %><% }) %></div>
<%- include('partials/pager', { base: '/people' }) %>
<%- include('partials/foot') %>
